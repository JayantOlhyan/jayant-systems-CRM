# JAYANT CRM — Environment Configuration
# Copy this file to .env.local for local development or configure in Vercel/production.

# PostgreSQL connection string (Supabase or standard PostgreSQL).
# If omitted in local development, JAYANT CRM automatically uses an embedded
# PostgreSQL 16 instance (PGlite) persisted at ./data/pgdata.
# DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres"

# Local PGlite storage path (used when DATABASE_URL is not set)
PGLITE_DATA_DIR="./data/pgdata"

# Authentication secret for signing HTTP-only session cookies (at least 32 characters)
CRM_SESSION_SECRET="change-me-to-a-secure-32-char-random-secret-key"

# Default single-user admin login credentials (can be updated inside Settings > Profile)
CRM_ADMIN_EMAIL="jayant@jayantwebsystems.com"
CRM_ADMIN_PASSWORD="jayant-crm-admin-2026"
CRM_WORKSPACE_NAME="Jayant Web & AI Systems"
CRM_DEFAULT_TIMEZONE="Asia/Kolkata"
CRM_DEFAULT_CURRENCY="INR"
